{
  "name": "localvision",
  "compatibility_date": "2026-11-19",
  "main": "worker.ts",
  "build": {
    "command": "node scripts/build-if-needed.mjs",
    "watch_dir": "frontend"
  },
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "not_found_handling": "single-page-application"
  }
}
