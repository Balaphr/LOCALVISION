{
  "name": "localvision",
  "compatibility_date": "2026-11-19",
  "main": "worker.ts",
  "build": {
    "command": "npm --prefix frontend install && npm --prefix frontend run build",
    "watch_dir": "frontend"
  },
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "not_found_handling": "single-page-application"
  }
}
