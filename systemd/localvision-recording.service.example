[Unit]
Description=LocalVision recording worker
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/localvision/backend
EnvironmentFile=/opt/localvision/.env
ExecStart=/opt/localvision/backend/.venv/bin/python -m app.services.recording_worker
Restart=always
RestartSec=5
WatchdogSec=30

[Install]
WantedBy=multi-user.target
