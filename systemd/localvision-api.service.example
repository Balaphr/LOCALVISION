[Unit]
Description=LocalVision Phase 1 API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/localvision/backend
EnvironmentFile=/opt/localvision/.env
ExecStart=/opt/localvision/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
