[Unit]
Description=LocalVision media ingest gateway
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/localvision
EnvironmentFile=/opt/localvision/.env
ExecStart=/opt/localvision/backend/.venv/bin/python -m app.services.media_worker
Restart=always
RestartSec=5
WatchdogSec=30

[Install]
WantedBy=multi-user.target
